<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.stockrecom.server</string>
    <!-- caffeinate -i: 서버가 떠 있는 동안 유휴 절전 방지 (스케줄러가 계속 돌아야 함) -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/caffeinate</string>
        <string>-i</string>
        <string>/Users/iyeongseob/dev/stockRecom/.venv/bin/uvicorn</string>
        <string>main:app</string>
        <string>--host</string>
        <string>127.0.0.1</string>
        <string>--port</string>
        <string>8000</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/iyeongseob/dev/stockRecom</string>
    <key>EnvironmentVariables</key>
    <dict>
        <!-- claude CLI(LLM 분석)가 node 를 찾을 수 있도록 nvm 경로 포함 -->
        <key>PATH</key>
        <string>/Users/iyeongseob/.local/bin:/Users/iyeongseob/.nvm/versions/node/v24.21.0/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>CLAUDE_BIN</key>
        <string>/Users/iyeongseob/.nvm/versions/node/v24.21.0/bin/claude</string>
        <key>HOME</key>
        <string>/Users/iyeongseob</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>15</integer>
    <key>StandardOutPath</key>
    <string>/Users/iyeongseob/dev/stockRecom/logs/server.out</string>
    <key>StandardErrorPath</key>
    <string>/Users/iyeongseob/dev/stockRecom/logs/server.err</string>
</dict>
</plist>
